# Optional: configure a Rove-owned Clerk and relay deployment.
# A fresh source build has cloud features disabled. Copy this file if you want
# local configuration, then fill in only identifiers belonging to your project.
# Do not add server-side secrets here.

# Clerk's free tier can be used for local development with your own instance.
# ROVE_CLERK_PUBLISHABLE_KEY=pk_test_...
# ROVE_CLERK_JWT_TEMPLATE=rove-relay
# ROVE_CLERK_CLI_OAUTH_CLIENT_ID=your-public-client-id

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in ROVE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# ROVE_APPLE_TEAM_ID=ABC1234567
# ROVE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/rove.provisionprofile
# ROVE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Cloud relay and hosted OAuth are not part of the self-hosted release.
# Supply only origins controlled by this project when those services exist.
# ROVE_RELAY_URL=https://relay.example.invalid
# ROVE_HOSTED_APP_URL=https://app.example.invalid

# Mobile native identity is opt-in. Local development clients do not need EAS
# updates, a store account, or a Clerk passkey relying-party domain.
# ROVE_EXPO_PROJECT_ID=your-own-expo-project-id
# ROVE_EXPO_OWNER=your-own-expo-account
# ROVE_MOBILE_UPDATES_ENABLED=1
# ROVE_CLERK_RELYING_PARTY_DOMAIN=your-own-clerk-rp-domain
# EXPO_PUBLIC_MARKETING_SITE_URL=https://your-reviewed-legal-site.example

# Public, ingest-only mobile OpenTelemetry configuration.
# ROVE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# ROVE_MOBILE_OTLP_TRACES_DATASET=rove-mobile-traces-dev
# ROVE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
