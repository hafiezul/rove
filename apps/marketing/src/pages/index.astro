---
import { Image } from "astro:assets";
import workspaceImage from "../assets/app-desktop.webp";
import reviewImage from "../assets/workspace-review.webp";
import mobileImage from "../assets/workspace-mobile.webp";
import Layout from "../layouts/Layout.astro";
import {
  GITHUB_REPOSITORY_URL,
  MOBILE_SOURCE_GUIDE_URL,
  REMOTE_ACCESS_GUIDE_URL,
  WEB_APP_URL,
} from "../lib/site";

const providers = [
  { name: "Claude Code", icon: "/harnesses/claude-ai-icon.svg", colored: true },
  { name: "Codex", icon: "/harnesses/openai_dark.svg", colored: false },
  { name: "Pi", icon: "/harnesses/pi.svg", colored: true },
  { name: "Cursor", icon: "/harnesses/cursor_light.svg", colored: false },
  { name: "OpenCode", icon: "/harnesses/opencode-dark.svg", colored: false },
  { name: "Grok", icon: "/harnesses/grok-dark.svg", colored: false },
  { name: "Antigravity", icon: "/harnesses/antigravity.svg", colored: true },
];
---

<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">Your agents. Your machines.<br />One place to work.</h1>
    <p>Run coding agents on your own machines. Review their work and pick it up from desktop, web, or mobile.</p>
    <div class="actions">
      <a class="button" href="/download">Get Rove Code</a>
      <a class="text-link" href={GITHUB_REPOSITORY_URL}>Explore the source</a>
    </div>
  </section>

  <section class="product container" id="workspace" aria-label="Inside the Rove workspace">
    <figure>
      <div class="workspace-frame">
        <picture>
          <source media="(max-width: 720px)" srcset={mobileImage.src} width={780} height={1160} />
          <Image src={workspaceImage} widths={[960, 1536, 2560, 3072]} sizes="(max-width: 1360px) calc(100vw - 80px), 1280px" format="webp" quality={95} loading="eager" fetchpriority="high" alt="A sample agent conversation in the Rove workspace. Captured from the real interface." />
        </picture>
      </div>
      <figcaption><span>Real interface. Sample project.</span><span class="desktop-caption">Conversation and code review, together.</span><span class="mobile-caption">The web client, on a smaller screen.</span></figcaption>
    </figure>
  </section>

  <section class="agents container" id="agents" aria-labelledby="agents-title">
    <div class="agents-heading">
      <h2 id="agents-title">Keep your favorite agents.</h2>
      <p>Bring your existing subscriptions or API credentials. Rove is the workspace, not another token reseller.</p>
    </div>
    <ul class="provider-strip" aria-label="Supported coding agents">
      {providers.map((provider) => (
        <li>
          <img class:list={[{ "mono-mark": !provider.colored, "pi-mark": provider.name === "Pi" }]} src={provider.icon} alt="" width="28" height="28" loading="lazy" />
          <span>{provider.name}</span>
        </li>
      ))}
    </ul>
    <p class="pi-note">Pi runs directly inside Rove. The other providers use their own runtimes.</p>
  </section>

  <section class="review-section container" aria-labelledby="review-title">
    <div class="review-copy">
      <h2 id="review-title">The conversation is only half the work.</h2>
      <p class="section-copy">See what changed, not just what the agent says changed. Keep diffs, files, and the terminal alongside the thread.</p>
      <dl class="review-details">
        <div><dt>Separate worktrees</dt><dd>Give parallel tasks their own space.</dd></div>
        <div><dt>Checkpoint diffs</dt><dd>Review changes turn by turn.</dd></div>
        <div><dt>Git, within reach</dt><dd>Commit, push, and open a pull request.</dd></div>
      </dl>
    </div>
    <figure class="review-visual">
      <Image src={reviewImage} widths={[640, 1078]} sizes="(max-width: 720px) calc(100vw - 40px), 600px" format="webp" quality={95} loading="lazy" alt="A close-up of Rove’s working-tree diff, showing file changes and inline code review. Sample project." />
      <figcaption>Review the work before it leaves your machine.</figcaption>
    </figure>
  </section>

  <section class="remote-section" id="remote" aria-labelledby="remote-title">
    <div class="container remote-inner">
      <figure class="phone-visual">
        <div class="phone-frame"><Image src={mobileImage} width={780} height={1160} format="webp" quality={92} loading="lazy" alt="The Rove web client showing the same sample conversation on a phone-sized screen." /></div>
        <figcaption>The web client, on a smaller screen.</figcaption>
      </figure>
      <div class="remote-copy">
        <h2 id="remote-title">Your desk is optional.<br />Your machine isn’t.</h2>
        <p class="section-copy">The host keeps your repositories, agents, and credentials. Connect from another screen without moving your project into someone else’s cloud.</p>
        <div class="remote-options">
          <article><h3>Desktop</h3><p>A local host is included. Connect remote machines over your network, Tailscale, or desktop SSH.</p><a class="text-link" href="/download">Get Rove Code</a></article>
          <article><h3>Web</h3><p>Pair with your own host. The hosted app needs a reachable HTTPS endpoint.</p><a class="text-link" href={WEB_APP_URL}>Open the web app</a></article>
          <article><h3>Mobile</h3><p>iOS and Android dev clients are available from source. No store releases yet.</p><a class="text-link" href={MOBILE_SOURCE_GUIDE_URL}>Build for mobile</a></article>
        </div>
        <a class="remote-guide text-link" href={REMOTE_ACCESS_GUIDE_URL}>Read the remote access guide</a>
      </div>
    </div>
  </section>

  <section class="ownership container" id="open-source" aria-labelledby="ownership-title">
    <h2 id="ownership-title">A workspace.<br />Not a walled garden.</h2>
    <div class="ownership-body">
      <p>Free to use. MIT licensed. Run your own host, change the interface, or fork the whole app. We started with T3 Code and are building our own path across providers, machines, and screens.</p>
      <div class="actions"><a class="button" href="/download">Get Rove Code</a><a class="text-link" href={GITHUB_REPOSITORY_URL}>Explore the source</a></div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: 4.25rem 3.5rem; }
  .hero h1 { max-width: 26ch; font-size: clamp(2.75rem, 4.9vw, 4.5rem); line-height: 1.09; }
  .hero > p { color: var(--fg-muted); font-size: 1.075rem; max-width: 56ch; margin-top: 1.5rem; }
  .hero .actions { margin-top: 1.75rem; }
  .product { padding-bottom: 1.5rem; }
  .workspace-frame { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; background: #090909; }
  .workspace-frame img { width: 100%; max-width: none; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; color: var(--fg-muted); padding-top: .9rem; font-size: .75rem; }
  .mobile-caption { display: none; }
  .agents { padding-block: 4rem 6rem; }
  .agents-heading { text-align: center; }
  .agents-heading h2 { font-size: 1.65rem; letter-spacing: -.02em; }
  .agents-heading p { color: var(--fg-muted); font-size: .95rem; max-width: 60ch; margin: .65rem auto 0; }
  .provider-strip { padding: 0; margin: 2rem 0 0; list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem 2.3rem; }
  .provider-strip li { display: flex; align-items: center; gap: .65rem; font-size: .9rem; min-height: 40px; }
  .provider-strip img { object-fit: contain; width: 26px; height: 26px; }
  .provider-strip .pi-mark { width: 40px; height: 40px; margin-inline: -7px; }
  :global([data-theme="light"]) .mono-mark { filter: brightness(0); }
  .pi-note { margin-top: 1.5rem; text-align: center; color: var(--fg-muted); font-size: .75rem; }
  .review-section { display: grid; grid-template-columns: 1fr 1.1fr; gap: 6rem; align-items: center; padding-block: 4rem 7rem; border-top: 1px solid var(--border); }
  .review-copy h2 { max-width: 14ch; }
  .review-copy > p { margin-top: 1.5rem; max-width: 40ch; }
  .review-details { margin: 2rem 0 0; display: flex; flex-direction: column; gap: 1.35rem; }
  .review-details dt { font-size: .95rem; font-weight: 500; }
  .review-details dd { margin: .2rem 0 0; color: var(--fg-muted); font-size: .85rem; }
  .review-visual img { width: 100%; border: 1px solid var(--border); border-radius: 12px; }
  .remote-section { background: var(--bg-elev); border-block: 1px solid var(--border); padding-block: 5.5rem; }
  .remote-inner { display: grid; grid-template-columns: .85fr 1.3fr; gap: 6rem; align-items: center; }
  .phone-visual { max-width: 330px; margin-inline: auto; }
  .phone-frame { padding: 7px; border-radius: 28px; border: 1px solid var(--border); background: #090909; }
  .phone-frame img { width: 100%; border-radius: 21px; }
  .phone-visual figcaption { justify-content: center; }
  .remote-copy > p { margin-top: 1.5rem; max-width: 46ch; }
  .remote-options { margin-top: 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .remote-options h3 { font-size: 1.2rem; }
  .remote-options p { margin-top: .6rem; color: var(--fg-muted); font-size: .85rem; }
  .remote-options a { margin-top: .65rem; font-size: .8rem; }
  .remote-guide { margin-top: 2rem; }
  .ownership { padding-block: 6rem; display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: center; }
  .ownership-body p { color: var(--fg-muted); max-width: 48ch; }
  .ownership-body .actions { margin-top: 1.75rem; }
  @media (max-width: 1100px) {
    .review-section, .remote-inner { gap: 3rem; }
    .remote-options { grid-template-columns: 1fr; gap: 1rem; }
    .remote-options p { max-width: 45ch; }
  }
  @media (max-width: 860px) {
    .review-section { grid-template-columns: 1fr; gap: 2.5rem; }
    .review-copy h2 { max-width: 22ch; }
    .review-details { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .review-visual { max-width: 650px; }
    .remote-inner { grid-template-columns: .8fr 1.2fr; gap: 2rem; }
    .ownership { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 720px) {
    .hero { padding-block: 2.5rem 2.5rem; }
    .hero h1 { font-size: clamp(2.5rem, 8.4vw, 3.5rem); max-width: 18ch; }
    .hero > p { font-size: 1rem; }
    .hero .actions { gap: 1rem; }
    .workspace-frame { border-radius: 8px; }
    .workspace-frame img { width: 100%; }
    .desktop-caption { display: none; }
    .mobile-caption { display: inline; }
    .agents { padding-block: 3rem 4rem; }
    .agents-heading { text-align: left; }
    .agents-heading p { margin-inline: 0; }
    .provider-strip { justify-content: flex-start; gap: 1rem 1.5rem; }
    .provider-strip li { font-size: .8rem; }
    .pi-note { text-align: left; }
    .review-section { padding-block: 3rem 4rem; }
    .review-details { grid-template-columns: 1fr; gap: 1rem; }
    .remote-section { padding-block: 3.5rem; }
    .remote-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .phone-visual { display: none; }
    .remote-options { grid-template-columns: 1fr; }
    .ownership { padding-block: 4rem; }
  }
</style>
