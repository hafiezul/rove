---
import { Image } from "astro:assets";
import icon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import {
  GITHUB_REPOSITORY_URL,
  MOBILE_SOURCE_GUIDE_URL,
  SOURCE_INSTALL_GUIDE_URL,
} from "../lib/site";
---

<Layout title="Get Rove Code" description="Build Rove Code from source for web, desktop, or mobile.">
  <div class="download-page">
    <header class="download-head">
      <div class="head-inner">
        <Image src={icon} width={58} height={58} alt="" loading="eager" decoding="async" />
        <h1>Get Rove Code</h1>
      </div>
      <p>Build from source today. This fork has not published desktop installers, npm packages, or mobile store apps.</p>
    </header>

    <div class="source-content">
      <section class="source-section" aria-labelledby="run-locally">
        <div class="section-heading">
          <span class="section-index" aria-hidden="true">01</span>
          <div>
            <h2 id="run-locally">Run locally</h2>
            <p>Install Node.js 24.13.1 and <a href="https://viteplus.dev/guide/" target="_blank" rel="noopener noreferrer">Vite+</a>, then run:</p>
          </div>
        </div>
        <pre><code>git clone https://github.com/hafiezul/rove.git
cd rove
vp i
vp run dev</code></pre>
        <p>The server prints a local web address. You'll need an installed, authenticated coding-agent provider to start a thread.</p>
        <a class="guide-link" href={SOURCE_INSTALL_GUIDE_URL} target="_blank" rel="noopener noreferrer">Read the source build guide <span aria-hidden="true">↗</span></a>
      </section>

      <section class="source-section" aria-labelledby="desktop-mobile">
        <div class="section-heading">
          <span class="section-index" aria-hidden="true">02</span>
          <div>
            <h2 id="desktop-mobile">Desktop and mobile</h2>
            <p>For a development desktop app, run <code>vp run dev:desktop</code> from the same checkout. Mobile requires a development client built from source; there are no App Store or Google Play builds from this fork.</p>
            <a class="guide-link" href={MOBILE_SOURCE_GUIDE_URL} target="_blank" rel="noopener noreferrer">Read the mobile build guide <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <p class="intel-note">
          On ARM? Download the arm64 <a data-asset="arm64.deb" href={RELEASES_URL}>.deb</a> or
          <a data-asset="arm64.AppImage" href={RELEASES_URL}>AppImage</a>.
        </p>
      </section>
    </div>

    <p class="source-note">Looking for a release? Follow <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">the repository</a> for updates. Upstream packages do not install this fork.</p>
  </div>
</Layout>

<style>
  .download-page {
    flex: 1;
    width: min(100% - 3rem, 720px);
    margin: 0 auto;
    padding-bottom: 5rem;
  }

  .download-head {
    padding: clamp(3rem, 8vh, 5.5rem) 0 2.75rem;
  }

  .head-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .download-head > p {
    max-width: 55ch;
    margin-top: 1.25rem;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .source-content {
    border-top: 1px solid var(--border);
  }

  .source-section {
    display: grid;
    gap: 1.25rem;
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .section-index {
    flex: 0 0 1.5rem;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  h2 {
    margin-bottom: 0.6rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .source-section p {
    max-width: 62ch;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .source-section a,
  .source-note a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--fg-dim);
    text-underline-offset: 3px;
  }

  .source-section a:hover,
  .source-note a:hover {
    text-decoration-color: var(--fg);
  }

  pre {
    overflow-x: auto;
    padding: 1.2rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .source-section code {
    font-family: var(--font-mono);
  }

  .source-section > p,
  .source-section > .guide-link,
  .source-section > pre {
    margin-left: 3rem;
  }

  .guide-link {
    width: fit-content;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .section-heading .guide-link {
    display: inline-block;
    margin-top: 1.25rem;
  }

  .source-note {
    padding-top: 2rem;
    color: var(--fg-dim);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .download-page {
      width: min(100% - 2.5rem, 720px);
    }

    .head-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-heading {
      gap: 1rem;
    }

    .source-section > p,
    .source-section > .guide-link,
    .source-section > pre {
      margin-left: 0;
    }
  }
</style>
