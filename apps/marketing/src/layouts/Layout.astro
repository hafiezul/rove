---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import displayFontUrl from "../assets/fonts/bricolage-grotesque-latin.woff2?url";
import "../styles/fonts.css";
import "../styles/brand.css";
import { GITHUB_REPOSITORY_URL, MOBILE_SOURCE_GUIDE_URL, USER_GUIDE_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Rove Code | Your agents. Your machines. One workspace.",
  description = "A free, open-source workspace for coding agents. Use the providers you choose, review their changes, and connect to your own machines from desktop, web, or mobile.",
  pageClass,
} = Astro.props;
const socialImageUrl = Astro.site ? new URL("/social.png", Astro.site) : null;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101318" />
    <script is:inline>
      // Apply the saved choice before first paint. New visitors always start dark.
      try {
        if (localStorage.getItem("rove-marketing-theme") === "light") {
          document.documentElement.dataset.theme = "light";
          document.querySelector('meta[name="theme-color"]').content = "#f4f6f9";
        }
      } catch {
        // Dark remains usable when storage is unavailable.
      }
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rove Code" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rove Code. Your agents. Your machines. One workspace." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={["page", pageClass]}>
      <header class="site-header">
        <div class="container header-inner">
          <a href="/" class="brand" aria-label="Rove Code home">
            <Image src={appIcon} alt="" width={38} height={38} densities={[1, 2]} loading="eager" />
            <span>Rove<span class="brand-code"> Code</span></span>
          </a>
          <nav aria-label="Main navigation">
            <a class="nav-detail" href="/#workspace">Workspace</a>
            <a class="nav-detail" href="/#agents">Agents</a>
            <a class="nav-detail" href={GITHUB_REPOSITORY_URL}>GitHub</a>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="true" title="Switch to light mode" hidden>
              <span class="theme-disc" aria-hidden="true"></span><span data-theme-label>Dark</span>
            </button>
            <a class="button nav-get" href="/download" aria-current={Astro.url.pathname === "/download" ? "page" : undefined}>Get Rove Code</a>
          </nav>
        </div>
      </header>

      <main id="main-content" tabindex="-1"><slot /></main>

      <footer class="site-footer">
        <div class="container">
          <div class="footer-top">
            <div>
              <a href="/" class="brand footer-wordmark">Rove Code</a>
              <p>Your agents. Your machines. Your call.</p>
            </div>
            <nav aria-label="Footer navigation">
              <a href="/download">Get Rove Code</a>
              <a href={USER_GUIDE_URL}>Documentation</a>
              <a href={GITHUB_REPOSITORY_URL}>Source code</a>
              <a href={MOBILE_SOURCE_GUIDE_URL}>Build for mobile</a>
              <a href={`${GITHUB_REPOSITORY_URL}/security/policy`}>Security</a>
            </nav>
          </div>
          <div class="footer-bottom">
            <p>Free and open source. <a href={`${GITHUB_REPOSITORY_URL}/blob/main/LICENSE`}>MIT licensed.</a></p>
            <p>Built on <a href="https://github.com/pingdotgg/t3code">T3 Code</a>. Taking our own path.</p>
          </div>
        </div>
      </footer>
    </div>
    <script>
      const themeToggle = document.getElementById("theme-toggle");
      const themeLabel = document.querySelector("[data-theme-label]");
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      function applyTheme(theme: "dark" | "light") {
        document.documentElement.dataset.theme = theme;
        const dark = theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(dark));
        themeToggle?.setAttribute("title", `Switch to ${dark ? "light" : "dark"} mode`);
        if (themeLabel) themeLabel.textContent = dark ? "Dark" : "Light";
        if (themeColor) themeColor.content = dark ? "#101318" : "#f4f6f9";
      }

      applyTheme(document.documentElement.dataset.theme === "light" ? "light" : "dark");
      if (themeToggle) themeToggle.hidden = false;
      themeToggle?.addEventListener("click", () => {
        const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(theme);
        try {
          localStorage.setItem("rove-marketing-theme", theme);
        } catch {
          // The toggle still works for this page when persistence is blocked.
        }
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "rove-marketing-theme" || event.key === null) {
          applyTheme(event.newValue === "light" ? "light" : "dark");
        }
      });
    </script>
  </body>
</html>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
  .site-header { padding-block: 1rem; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; letter-spacing: -.025em; text-decoration: none; white-space: nowrap; }
  .brand img { border-radius: 10px; }
  .brand-code { font-weight: 500; }
  .header-inner nav { display: flex; align-items: center; gap: 1.75rem; }
  .theme-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-width: 80px; min-height: 42px; padding: .5rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--fg-muted); font-size: .8rem; cursor: pointer; }
  .theme-toggle:hover { background: var(--bg-elev); color: var(--fg); }
  .theme-toggle:active { background: var(--bg-card); }
  .theme-disc { width: 15px; height: 15px; border: 1.5px solid currentColor; border-radius: 50%; background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  .nav-detail { font-size: .9rem; text-decoration: none; }
  .nav-detail:hover { color: var(--accent); }
  .nav-get { min-height: 42px; padding: .6rem 1.15rem; font-size: .85rem; }
  .site-footer { margin-top: auto; padding-block: 3.5rem 2rem; border-top: 1px solid var(--border); background: var(--bg); }
  .footer-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding-bottom: 3.5rem; }
  .footer-wordmark { font-size: 2rem; }
  .footer-top p { color: var(--fg-muted); margin-top: .4rem; }
  .footer-top nav { display: grid; grid-template-columns: repeat(2, auto); gap: .7rem 3rem; }
  .footer-top nav a { font-size: .9rem; text-decoration: none; }
  .footer-top nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer-bottom { border-top: 1px solid var(--border); padding-top: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem 2rem; font-size: .8rem; color: var(--fg-muted); }
  .footer-bottom a { text-underline-offset: 3px; }
  @media (max-width: 720px) {
    .site-header { padding-block: 1rem; }
    .header-inner nav { gap: .75rem; }
    .nav-detail { display: none; }
    .brand { font-size: 1.3rem; gap: .5rem; }
    .brand img { width: 32px; height: 32px; }
    .footer-top { flex-direction: column; padding-bottom: 2rem; }
    .footer-top nav { gap: .75rem 2rem; }
    .site-footer { padding-top: 3rem; }
  }
  @media (max-width: 520px) {
    .brand-code { display: none; }
    .header-inner { gap: .75rem; }
    .theme-toggle { min-width: 42px; width: 42px; }
    [data-theme-label] { display: none; }
    .nav-get { padding-inline: .8rem; }
  }
</style>
